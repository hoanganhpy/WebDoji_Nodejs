<% if(!dataDetailSp[0]) { %>
    <p style="text-align: center;">Không có sản phẩm nào</p>
<% } else { %>
    <div class="container" style="background: white;">
        <div class="Tieu_de" style="margin-top: 10px;">
            <div>
                Chi tiết sản phẩm: <%= dataDetailSp[0].TenSanPham %>
            </div>
        </div>

        <div class="row">
            <div class="col-md-5" style="display: flex;justify-content: center;align-items: center;margin-bottom: 10px;">
                <img src="/admin/image/<%= dataDetailSp[0].imgName %>" alt="" id="img_main" style="box-shadow: 0px 0px 5px 0px;border-radius: 5%; max-height: 245px;">
                <div class="row" style="margin-top: 5px;">
                </div>
            </div>
            <div class="col-md-7">
                <form action="/customer/san-pham/add-to-cart" method="post">
                    <h3 style="padding-bottom: 5px;"><%= dataDetailSp[0].TenSanPham %></h3>
                    <p>Giá: <strong style="color:#b8860b; font-size: 1.25rem;"><%= vnd(dataDetailSp[0].GiaBan) %> ₫</strong></p>
                    <p>Xuất xứ: <%= dataDetailSp[0].XuatXu %></p>
                    <p>Số lượng hiện có: <%= dataDetailSp[0].SoLuong %></p>
                    <div class="form-group d-flex align-items-center" style="gap: 10px;">
                        <label for="SoLuongMua" class="mb-0">Số lượng mua:</label>
                        <input type="number" class="form-control" style="width: 110px;" id="SoLuongMua" name="SoLuongMua" value="1" min="1" max="<%= dataDetailSp[0].SoLuong %>" required>
                    </div>
                    <input type="hidden" name="idLsp" value="<%= dataDetailSp[0].ID_LoaiSanPham %>">
                    <input type="hidden" name="idSp" value="<%= dataDetailSp[0].ID %>">
                    <button type="submit" class="btn btn-danger"><i class="fa fa-cart-plus" aria-hidden="true"></i> Thêm vào giỏ hàng</button>
                </form>
                
            </div>
        </div>
    </div>
    <div class="container" style="background: white;">
        <div class="Tieu_de" style="margin-top: 10px;">
            <div>
                Sản phẩm cùng loại
            </div>
        </div>
        <% if(!dataSameSp[0]) { %>
            <p style="text-align: center;">Chưa có sản phẩm cùng loại</p>
        <% } else { %>
        <div class="row">
            <% dem = 1; dataSameSp.forEach((data) => {
                if(dem <= 6 ){ %>
                    <div class="col-sm-2"><a href="/customer/san-pham/chi-tiet/<%= data.ID_LoaiSanPham %>/<%= data.ID %>" style="color: black;">
                        <div class="card" style="width: 10rem;">
                        <img src="/admin/image/<%= data.imgName %>" class="card-img-top" id="NgoaiNhap1" alt="..." style="max-height: 250px">
                        <div class="card-body">
                            Tên: <%= data.TenSanPham %><br>
                            Xuất xứ: <%= data.XuatXu %><br>
                            Giá bán: <%= vnd(data.GiaBan) %> ₫<br>
                            Số lượng:  <%= data.SoLuong %> 
                        </div>
                        </div></a>
                    </div>
                <%  dem += 1
                }
            }) %>
        </div>
        <div class="d-grid gap-2 d-md-flex justify-content-md-end" style="margin: 10px 0px;">
            <button class="btn btn-primary me-md-2" type="button" style="background: #00e85d;border-color: #00e85d;"><a href="/customer/san-pham/loai-san-pham/<%= dataSameSp[0].ID_LoaiSanPham %>">Xem tất cả <i class="fa fa-arrow-right" aria-hidden="true"></i></a></button>
        </div>
        <% } %>
    </div>
<% } %>