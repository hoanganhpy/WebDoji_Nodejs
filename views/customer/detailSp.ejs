<% if (!dataDetailSp[0]) { %>
    <section class="section"><div class="container-x"><div class="empty"><i class="bi bi-gem"></i><h3>Không tìm thấy sản phẩm</h3><a class="btn-x" href="/customer/home">Về trang chủ</a></div></div></section>
<% } else { const sp = dataDetailSp[0]; const low = sp.SoLuong <= 5; %>
<section class="page-head" style="padding-bottom: 8px;">
    <div class="container-x">
        <div class="crumbs"><a href="/customer/home">Trang chủ</a><i class="bi bi-chevron-right"></i><a href="/customer/san-pham/loai-san-pham/<%= sp.ID_LoaiSanPham %>"><%= sp.LoaiSanPham %></a><i class="bi bi-chevron-right"></i><span><%= sp.TenSanPham %></span></div>
    </div>
</section>
<section class="section" style="padding-top: 16px;">
    <div class="container-x pd">
        <div class="pd-media"><img src="/admin/image/<%= sp.imgName %>" alt="<%= sp.TenSanPham %>"></div>
        <div>
            <span class="eyebrow"><%= sp.LoaiSanPham %></span>
            <h1><%= sp.TenSanPham %></h1>
            <div class="price"><%= vnd(sp.GiaBan) %> ₫</div>
            <dl class="meta">
                <dt>Xuất xứ</dt><dd><%= sp.XuatXu %></dd>
                <dt>Tình trạng</dt><dd><span class="stock <%= low ? 'low' : '' %>"><%= sp.SoLuong > 0 ? (low ? 'Chỉ còn ' + sp.SoLuong + ' sản phẩm' : 'Còn hàng (' + sp.SoLuong + ')') : 'Hết hàng' %></span></dd>
                <dt>Mã sản phẩm</dt><dd>WD-<%= String(sp.ID).padStart(4, '0') %></dd>
            </dl>
            <% if (sp.SoLuong > 0) { %>
            <form action="/customer/san-pham/add-to-cart" method="post">
                <input type="hidden" name="idLsp" value="<%= sp.ID_LoaiSanPham %>">
                <input type="hidden" name="idSp" value="<%= sp.ID %>">
                <div class="buy-row">
                    <div class="qty">
                        <button type="button" aria-label="Giảm" onclick="this.nextElementSibling.stepDown()">−</button>
                        <input type="number" name="SoLuongMua" value="1" min="1" max="<%= sp.SoLuong %>" required aria-label="Số lượng">
                        <button type="button" aria-label="Tăng" onclick="this.previousElementSibling.stepUp()">+</button>
                    </div>
                    <button type="submit" class="btn-x" style="flex:1"><i class="bi bi-bag-plus"></i> Thêm vào giỏ hàng</button>
                </div>
            </form>
            <% } %>
            <div class="perks">
                <div><i class="bi bi-patch-check"></i>Kiểm định chất lượng, kèm giấy chứng nhận</div>
                <div><i class="bi bi-gift"></i>Đóng gói hộp quà, miễn phí giao hàng toàn quốc</div>
                <div><i class="bi bi-shield-check"></i>Bảo hành, làm sạch và đánh bóng trọn đời</div>
            </div>
        </div>
    </div>
</section>
<% if (dataSameSp.length) { %>
<section class="section">
    <div class="container-x">
        <div class="section-head">
            <div><span class="eyebrow">Cùng dòng</span><h2>Có thể bạn sẽ thích</h2></div>
            <a class="link-more" href="/customer/san-pham/loai-san-pham/<%= sp.ID_LoaiSanPham %>">Xem tất cả <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="grid-products">
            <% dataSameSp.slice(0, 4).forEach((p) => { %><%- include('./partials/product-card.ejs', { p }) %><% }) %>
        </div>
    </div>
</section>
<% } %>
<% } %>
