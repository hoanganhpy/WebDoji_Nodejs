<section class="page-head">
    <div class="container-x">
        <div class="crumbs"><a href="/customer/home">Trang chủ</a><i class="bi bi-chevron-right"></i><span>Tìm kiếm</span></div>
        <h1>Kết quả cho “<%= title %>”</h1>
        <p class="muted"><%= dataSp.length %> sản phẩm</p>
    </div>
</section>
<section class="section" style="padding-top: 8px;">
    <div class="container-x">
        <% if (!dataSp.length) { %>
            <div class="empty"><i class="bi bi-search"></i><h3>Không tìm thấy sản phẩm</h3><p class="muted">Thử một từ khóa khác như “nhẫn”, “lắc tay” hoặc “kim cương”.</p><a class="btn-x" href="/customer/home">Về trang chủ</a></div>
        <% } else { %>
            <div class="grid-products">
                <% dataSp.forEach((p) => { %><%- include('./partials/product-card.ejs', { p }) %><% }) %>
            </div>
        <% } %>
    </div>
</section>
