<% let tong = 0; dataCart.forEach((d) => { tong += Number(d.ThanhTien); }); %>
<section class="page-head">
    <div class="container-x">
        <div class="crumbs"><a href="/customer/home">Trang chủ</a><i class="bi bi-chevron-right"></i><span>Giỏ hàng</span></div>
        <h1>Giỏ hàng</h1>
        <p class="muted"><%= dataCart.length %> sản phẩm</p>
    </div>
</section>
<section class="section" style="padding-top: 8px;">
    <div class="container-x">
    <% if (!dataCart.length) { %>
        <div class="empty"><i class="bi bi-bag"></i><h3>Giỏ hàng đang trống</h3><p class="muted">Khám phá bộ sưu tập và chọn món trang sức bạn yêu thích.</p><a class="btn-x" href="/customer/home">Mua sắm ngay</a></div>
    <% } else { %>
        <div class="cart-layout">
            <div class="card-x">
                <h3>Sản phẩm</h3>
                <% dataCart.forEach((d) => { %>
                <div class="cart-item">
                    <div class="thumb"><img src="/admin/image/<%= d.imgName %>" alt=""></div>
                    <div>
                        <div class="name"><%= d.TenSanPham %></div>
                        <div class="sub"><%= d.XuatXu %> · <%= vnd(d.DonGia) %> ₫</div>
                        <form class="inline-qty" action="/customer/cart/update" method="post">
                            <input type="hidden" name="idSanPham" value="<%= d.IDSanPham %>">
                            <input type="number" name="SoLuong" value="<%= d.SoLuong %>" min="1" max="<%= d.SoLuongSpTrongKho + d.SoLuong %>" aria-label="Số lượng">
                            <button class="btn-x ghost sm" type="submit">Cập nhật</button>
                        </form>
                    </div>
                    <div class="right">
                        <span class="line-total"><%= vnd(d.ThanhTien) %> ₫</span>
                        <form action="/customer/cart/delete" method="post">
                            <input type="hidden" name="idCart" value="<%= d.ID %>">
                            <button class="btn-link-x" type="submit"><i class="bi bi-trash3"></i> Xóa</button>
                        </form>
                    </div>
                </div>
                <% }) %>
            </div>
            <form class="card-x" action="/customer/cart/order" method="post">
                <h3>Thanh toán</h3>
                <div class="summary-row"><span class="muted">Tạm tính</span><span><%= vnd(tong) %> ₫</span></div>
                <div class="summary-row"><span class="muted">Vận chuyển</span><span style="color: var(--ok); font-weight: 600;">Miễn phí</span></div>
                <div class="summary-row total"><span>Tổng cộng</span><b><%= vnd(tong) %> ₫</b></div>
                <hr style="border: 0; border-top: 1px solid var(--line); margin: 18px 0;">
                <div class="field"><label>Họ và tên <span class="req">*</span></label><input class="input-x" type="text" name="ho_ten" autocomplete="name" required></div>
                <div class="field"><label>Điện thoại <span class="req">*</span></label><input class="input-x" type="tel" name="sdt" maxlength="10" pattern="[0-9]{10}" placeholder="10 chữ số" autocomplete="tel" required></div>
                <div class="field"><label>Tỉnh / thành phố <span class="req">*</span></label><select class="select-x" id="city" name="tinhtp" required><option value="">Chọn tỉnh / thành</option></select></div>
                <div class="grid-2">
                    <div class="field"><label>Quận / huyện <span class="req">*</span></label><select class="select-x" id="district" name="quanhuyen" required><option value="">Chọn</option></select></div>
                    <div class="field"><label>Phường / xã <span class="req">*</span></label><select class="select-x" id="ward" name="xa" required><option value="">Chọn</option></select></div>
                </div>
                <div class="field"><label>Địa chỉ cụ thể</label><input class="input-x" type="text" name="DiaChiCuThe" placeholder="Số nhà, tên đường" autocomplete="street-address"></div>
                <div class="field"><label>Ghi chú</label><textarea class="textarea-x" name="ghi_chu" maxlength="200" placeholder="Ví dụ: giao giờ hành chính"></textarea></div>
                <button class="btn-x block" type="submit"><i class="bi bi-lock"></i> Đặt hàng</button>
                <p class="muted" style="font-size: 12.5px; text-align: center; margin: 12px 0 0;">Thanh toán khi nhận hàng (COD)</p>
            </form>
        </div>
    <% } %>
    </div>
</section>
<script>
    // Province → district → ward pickers, data from /customer/css/data.json
    (async function () {
        const city = document.getElementById('city');
        if (!city) return;
        const district = document.getElementById('district');
        const ward = document.getElementById('ward');
        const data = await fetch('/customer/css/data.json').then((r) => r.json());
        const fill = (el, items) => { el.length = 1; items.forEach((x) => el.add(new Option(x.Name, x.Name))); };
        fill(city, data);
        city.onchange = () => { const c = data.find((x) => x.Name === city.value); fill(district, c ? c.Districts : []); fill(ward, []); };
        district.onchange = () => {
            const c = data.find((x) => x.Name === city.value);
            const d = c && c.Districts.find((x) => x.Name === district.value);
            fill(ward, d ? d.Wards : []);
        };
    })();
</script>
