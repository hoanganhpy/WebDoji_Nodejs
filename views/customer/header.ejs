<div class="topbar">
    <div class="container-x">
        <span><i class="bi bi-truck"></i>Miễn phí giao hàng toàn quốc</span>
        <span><i class="bi bi-shield-check"></i>Bảo hành trọn đời</span>
        <span><i class="bi bi-arrow-repeat"></i>Đổi trả trong 30 ngày</span>
    </div>
</div>
<header class="site-header">
    <div class="container-x">
        <a class="brand" href="/customer/home"><%- include('./partials/logo.ejs') %>WebDoji</a>
        <ul class="nav-x">
            <li><a href="/customer/home" class="<%= currentPath.startsWith('/customer/home') ? 'active' : '' %>">Trang chủ</a></li>
            <li>
                <a href="#" class="<%= currentPath.includes('/loai-san-pham') ? 'active' : '' %>">Danh mục <i class="bi bi-chevron-down small"></i></a>
                <div class="menu">
                    <% dataHeaderSp.forEach((c) => { %>
                        <a href="/customer/san-pham/loai-san-pham/<%= c.ID %>"><%= c.Ten %></a>
                    <% }) %>
                </div>
            </li>
            <li>
                <a href="#" class="<%= currentPath.includes('/xuat-xu') ? 'active' : '' %>">Xuất xứ <i class="bi bi-chevron-down small"></i></a>
                <div class="menu">
                    <% dataHeaderXx.forEach((x) => { %>
                        <a href="/customer/san-pham/xuat-xu/<%= x.ID %>"><%= x.XuatXu %></a>
                    <% }) %>
                </div>
            </li>
        </ul>
        <form class="header-search" method="post" action="/customer/san-pham/search" role="search">
            <i class="bi bi-search"></i>
            <input type="search" name="search" placeholder="Tìm nhẫn, lắc tay, dây chuyền…" aria-label="Tìm kiếm">
        </form>
        <div class="header-actions">
            <a class="icon-btn" href="/customer/cart" aria-label="Giỏ hàng">
                <i class="bi bi-bag"></i>
                <% if (cartCount > 0) { %><span class="badge-x"><%= cartCount %></span><% } %>
            </a>
            <% if (!sessionID) { %>
                <div class="auth-links">
                    <a class="btn-x ghost sm" href="/customer/login">Đăng nhập</a>
                    <a class="btn-x sm" href="/customer/signup">Đăng ký</a>
                </div>
            <% } else { %>
                <div class="account">
                    <button class="icon-btn" aria-label="Tài khoản"><i class="bi bi-person"></i></button>
                    <div class="menu">
                        <div class="who">Xin chào, <b><%= sessionID.TenTK %></b></div>
                        <a href="/customer/don-hang"><i class="bi bi-box-seam"></i>Đơn hàng của tôi</a>
                        <a href="/customer/don-hang/lich-su"><i class="bi bi-clock-history"></i>Lịch sử mua hàng</a>
                        <a href="/customer/changePass"><i class="bi bi-key"></i>Đổi mật khẩu</a>
                        <a href="/customer/logout"><i class="bi bi-box-arrow-right"></i>Đăng xuất</a>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</header>
