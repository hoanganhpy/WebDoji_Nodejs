<span class="eyebrow">Thành viên mới</span>
<h1>Tạo tài khoản</h1>
<p class="muted" style="margin-bottom: 24px;">Chỉ mất 30 giây để bắt đầu mua sắm.</p>
<% if (error) { %><div class="alert-x"><i class="bi bi-exclamation-circle"></i> <%= error %></div><% } %>
<form method="post" action="/customer/signup">
    <div class="field"><label for="tk">Tên tài khoản</label><input class="input-x" id="tk" type="text" name="usename" value="<%= typeof usename !== 'undefined' ? usename : '' %>" autocomplete="username" required></div>
    <div class="field"><label for="mk">Mật khẩu</label><input class="input-x" id="mk" type="password" name="password" minlength="6" autocomplete="new-password" required></div>
    <div class="field"><label for="mk2">Nhập lại mật khẩu</label><input class="input-x" id="mk2" type="password" name="password_repeat" minlength="6" autocomplete="new-password" required></div>
    <label class="check"><input type="checkbox" name="checkboxx" value="yes" required> Tôi đồng ý với điều khoản sử dụng và chính sách bảo mật.</label>
    <button class="btn-x block" type="submit">Đăng ký</button>
</form>
<p class="muted" style="margin-top: 20px; font-size: 14px;">Đã có tài khoản? <a href="/customer/login" style="color: var(--gold-2); font-weight: 600;">Đăng nhập</a></p>
