<%
  const items = dataLsp || dataXx || [];
  const heading = dataLsp ? (items[0] && items[0].Ten) : (items[0] && items[0].XuatXu);
  const kind = dataLsp ? 'Danh mục' : 'Xuất xứ';
%>
<section class="page-head">
    <div class="container-x">
        <div class="crumbs"><a href="/customer/home">Trang chủ</a><i class="bi bi-chevron-right"></i><span><%= kind %></span><% if (heading) { %><i class="bi bi-chevron-right"></i><span><%= heading %></span><% } %></div>
        <h1><%= heading || kind %></h1>
        <p class="muted"><%= items.length %> sản phẩm</p>
    </div>
</section>
<section class="section" style="padding-top: 8px;">
    <div class="container-x">
        <% if (!items.length) { %>
            <div class="empty"><i class="bi bi-gem"></i><h3>Chưa có sản phẩm</h3><p class="muted">Danh mục này đang được cập nhật.</p><a class="btn-x" href="/customer/home">Về trang chủ</a></div>
        <% } else { %>
            <div class="grid-products">
                <% items.forEach((p) => { %><%- include('./partials/product-card.ejs', { p }) %><% }) %>
            </div>
        <% } %>
    </div>
</section>
