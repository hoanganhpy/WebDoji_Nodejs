<% const nav = [
    ['home', '/admin', 'bi-grid-1x2', 'Tổng quan'],
    ['orders', '/admin/hoa-don', 'bi-receipt', 'Đơn hàng'],
    ['products', '/admin/san-pham', 'bi-gem', 'Sản phẩm'],
    ['types', '/admin/loai-san-pham', 'bi-tags', 'Loại sản phẩm'],
    ['origins', '/admin/xuat-xu-san-pham', 'bi-globe2', 'Xuất xứ'],
    ['users', '/admin/user', 'bi-people', 'Khách hàng'],
    ['stats', '/admin/thong-ke', 'bi-bar-chart-line', 'Thống kê'],
];
const path = typeof currentPath !== 'undefined' ? currentPath : '';
const isActive = (key, href) => (typeof active !== 'undefined' && active === key) || (href !== '/admin' && path.startsWith(href)); %>
<aside class="sidebar">
    <a class="sb-brand" href="/admin"><img src="/customer/logo-mark.svg" alt="">WebDoji<span>Admin</span></a>
    <nav>
        <% nav.forEach(([key, href, icon, label]) => { %>
            <a href="<%= href %>" class="<%= isActive(key, href) ? 'active' : '' %>"><i class="bi <%= icon %>"></i><%= label %></a>
        <% }) %>
    </nav>
    <div class="sb-foot">
        <a href="/customer/home" target="_blank"><i class="bi bi-box-arrow-up-right"></i>Xem cửa hàng</a>
        <a href="/admin/login"><i class="bi bi-box-arrow-left"></i>Đăng xuất</a>
    </div>
</aside>
