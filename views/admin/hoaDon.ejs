<style>
    body {
        font-family: Arial, Helvetica, sans-serif;
    }

    * {
        box-sizing: border-box;
    }

    .container {
        padding: 16px;
    }

    .modal {
        display: none;
        /* Hidden by default */
        position: fixed;
        /* Stay in place */
        z-index: 1;
        /* Sit on top */
        left: 0;
        top: 0;
        width: 100%;
        /* Full width */
        height: 100%;
        /* Full height */
        overflow: auto;
        /* Enable scroll if needed */
        background-color: #474e5d;
        padding-top: 50px;
    }

    .modal-content {
        background-color: #fefefe;
        margin: 5% auto 15% auto;
        /* 5% from the top, 15% from the bottom and centered */
        border: 1px solid #888;
        width: 80%;
        /* Could be more or less, depending on screen size */
    }

    hr {
        border: 1px solid #f1f1f1;
        margin-bottom: 25px;
    }

    .close {
        position: absolute;
        right: 35px;
        top: 15px;
        font-size: 40px;
        font-weight: bold;
        color: #f1f1f1;
    }

    .close:hover,
    .close:focus {
        color: #f44336;
        cursor: pointer;
    }

    .input {
        width: 100%;
        padding: 15px;
        margin: 5px 0 22px 0;
        display: inline-block;
        border: none;
        background: #f1f1f1;
    }

    .input:focus {
        background-color: #ddd;
        outline: none;
    }

    .clearfix{
        display: flex;
        justify-content: space-around;
    }
    .custom-select-sp select{
        width: 100%;
        padding: 15px;
        margin: 5px 0 22px 0;
        background-color: #f1f1f1;
        border: none;
        appearance: none;
    }
</style>
<h1>Đơn hàng</h1>
<div>
    <input type="text" id="myInput" onkeyup="search_table_hd()" placeholder="Tìm kiếm ..." title="Type in a name">
</div>
<table id="myTable">
    <tr class="header">
        <th>Mã đơn</th>
        <th>Khách hàng</th>
        <th>Địa chỉ</th>
        <th>Tổng tiền</th>
        <th>Ngày mua</th>
        <th>Trạng thái</th>
        <th>Thao tác</th>
    </tr>
    <% dataHd.forEach((data) => { %>
    <tr>
        <td><b>#<%= String(data.ID).padStart(5, '0') %></b></td>
        <td style="min-width: 150px;"><b style="font-weight: 600;"><%= data.TenKH %></b><div style="color: var(--muted); font-size: 12.5px;"><%= data.SDT %> · TK #<%= data.IDTK %></div></td>
        <td style="min-width: 220px; max-width: 320px;"><%= data.DiaChi %><% if (data.GhiChu) { %><div style="color: var(--muted); font-size: 12.5px;">“<%= data.GhiChu %>”</div><% } %></td>
        <td style="white-space: nowrap; font-weight: 600;"><%= vnd(data.TongTien) %> ₫</td>
        <td style="white-space: nowrap;"><%= data.NgayMua %></td>
        <td><span class="pill <%= data.TrangThai == 2 ? 'ok' : (data.TrangThai == 3 ? 'bad' : '') %>"><%= data.TenTT %></span></td>
        <td style="white-space: nowrap;">
            <button onclick="document.getElementById('detail<%= data.ID %>').style.display='block'" style="width:auto;">Chi tiết</button>
            <div id="detail<%= data.ID %>" class="modal">
                <span onclick="document.getElementById('detail<%= data.ID %>').style.display='none'" class="close" title="Close Modal">&times;</span>
                <div class="modal-content">
                    <div class="container">
                        <h1 style="text-align:center;">Hóa đơn</h1>
                        <table id="myTable_bottom" style="margin-bottom: 10px;">
                            <tr class="header_bottom">
                                <th>STT</th>
                                <th>ID tài khoản</th>
                                <th>Tên khách hàng</th>
                                <th>Địa chỉ</th>
                                <th>Số điện thoại</th>
                                <th>Tổng tiền</th>
                                <th>Ngày mua</th>
                                <th>Ghi chú</th>
                                <th>Trạng thái</th>
                            </tr>
                            <tr>
                                <td><%= Stt %></td>
                                <td><%= data.IDTK %></td>
                                <td><%= data.TenKH %></td>
                                <td><%= data.DiaChi %></td>
                                <td><%= data.SDT %></td>
                                <td><%= vnd(data.TongTien) %></td>
                                <td>
                                    <%= data.NgayMua %>
                                </td>
                                <td><%= data.GhiChu %></td>
                                <td><%= data.TenTT %></td>
                            </tr>
                        </table>
                        <hr>
                        <h3 style="text-align:center;">Chi tiết hóa đơn</h3>
                        <table id="myTable_bottom" style="margin-bottom: 10px;">
                            <tr class="header_bottom">
                                <th>STT</th>
                                <th>ID sản phẩm</th>
                                <th>Tên sản phẩm</th>
                                <th>Ảnh</th>
                                <th>Xuất xứ</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                            </tr>
                            <% dem = 0; dataCthd.forEach((datacthd) => { 
                                if(data.ID == datacthd.ID_HoaDon) { %>
                                <tr>
                                    <td><%= dem += 1 %></td>
                                    <td><%= datacthd.IDSanPham %></td>
                                    <td><%= datacthd.TenSanPham %></td>
                                    <td>
                                        <img src="/admin/image/<%= datacthd.imgName %>" alt="" style="max-width: 60px">  
                                    </td>
                                    <td><%= datacthd.XuatXu %></td>
                                    <td><%= vnd(datacthd.GiaBan) %></td>
                                    <td><%= datacthd.SoLuong %></td>
                                    <td><%= vnd(datacthd.ThanhTien) %></td>
                                </tr>
                               <% }
                             }) %>
                        </table>
                        <div class="clearfix">
                            <button type="button" onclick="document.getElementById('detail<%= data.ID %>').style.display='none'" class="cancelbtn">Đóng</button>
                            <!-- <button type="submit" class="CUDbtn">Xóa</button> -->
                        </div>
                    </div>
                </div>
                
            </div>
            <% if (data.TrangThai == 1) { %>
                <a href="/admin/hoa-don/nhan/<%= data.ID %>"><button class="primary" style="background: var(--ink); color: #fff;">Xác nhận</button></a>
                <a href="/admin/hoa-don/huy/<%= data.ID %>" onclick="return confirm('Hủy đơn này?')"><button>Hủy</button></a>
            <% } %>
        </td>
        
    </tr>
    <% }) %>
</table>