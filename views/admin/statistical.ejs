<% let tong = 0, sl = 0; dataStatis.forEach((d) => { tong += Number(d.ThanhTien); sl += Number(d.SoLuong); }); %>
<h1>Thống kê bán hàng</h1>
<form class="filter-bar" action="/admin/thong-ke/search">
    <label>Từ ngày<input type="date" name="dateStart" value="<%= dateStart %>" max="<%= dateEnd %>" required></label>
    <label>Đến ngày<input type="date" name="dateEnd" value="<%= dateEnd %>" required></label>
    <input type="submit" class="primary" value="Xem thống kê">
</form>

<div class="kpis" style="grid-template-columns: repeat(3, 1fr);">
    <div class="kpi"><div class="label">Doanh thu <i class="bi bi-cash-coin"></i></div><div class="value"><%= vnd(tong) %> ₫</div><div class="hint">Không tính đơn đã hủy</div></div>
    <div class="kpi"><div class="label">Sản phẩm đã bán <i class="bi bi-bag-check"></i></div><div class="value"><%= sl %></div></div>
    <div class="kpi"><div class="label">Mặt hàng <i class="bi bi-gem"></i></div><div class="value"><%= dataStatis.length %></div></div>
</div>

<% if (!dataStatis.length) { %>
    <div class="panel empty-note">Không có đơn hàng trong khoảng thời gian này.</div>
<% } else { %>
<div class="panel-grid">
    <div class="panel"><h3>Doanh thu theo sản phẩm</h3><div class="chart-box"><canvas id="statChart"></canvas></div></div>
    <div class="panel">
        <h3>Chi tiết</h3>
        <table id="myTable">
            <tr class="header"><th>Sản phẩm</th><th>SL</th><th>Thành tiền</th></tr>
            <% dataStatis.forEach((d) => { %>
                <tr><td><%= d.TenSanPham %><div style="color: var(--muted); font-size: 12px;"><%= vnd(d.GiaBan) %> ₫</div></td><td><%= d.SoLuong %></td><td><%= vnd(d.ThanhTien) %> ₫</td></tr>
            <% }) %>
        </table>
    </div>
</div>
<script src="/vendor/chart.js/chart.umd.js"></script>
<script>
    const rows = <%- JSON.stringify(dataStatis.map((d) => ({ name: d.TenSanPham, total: Number(d.ThanhTien) }))) %>;
    new Chart(document.getElementById('statChart'), {
        type: 'bar',
        data: { labels: rows.map((r) => r.name), datasets: [{ data: rows.map((r) => r.total), backgroundColor: '#b08d57', borderRadius: 8, maxBarThickness: 46 }] },
        options: {
            maintainAspectRatio: false, indexAxis: 'y',
            plugins: { legend: { display: false }, tooltip: { callbacks: { label: (c) => c.parsed.x.toLocaleString('vi-VN') + ' ₫' } } },
            scales: { x: { grid: { color: '#efe9df' }, ticks: { callback: (v) => (v / 1e6).toLocaleString('vi-VN') + 'tr' } }, y: { grid: { display: false } } }
        }
    });
</script>
<% } %>
